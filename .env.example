# Same-origin API recommended. No secrets belong in VITE_ variables.
VITE_API_BASE=
VITE_MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_BYTES=8388608
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Hosting platforms may supply PORT automatically.
PORT=8000

# Local CPU detector: pre-cache with python scripts/setup_detector.py (operator setup only).
WILDID_DETECTOR=onnx-world
DETECTION_SCORE_CUTOFF=0.25
DETECTION_TIMEOUT_SECONDS=8
# Optional absolute directory; default models/tiger-open-vocabulary under project root.
# DETECTOR_DIR=/absolute/path/to/models/tiger-open-vocabulary
# WILDID_DETECTOR=none explicitly disables detection without disabling retrieval.
